<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>be.jsilkens.cortex</groupId>
    <artifactId>cortex-root</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Cortex Root</name>
    <description>Multi-module Maven project for the Cortex AI copilot system</description>

    <properties>
        <java.version>21</java.version>
        <lombok.version>1.18.44</lombok.version>
        <archunit.version>1.4.0</archunit.version>
        <testcontainers.version>1.21.1</testcontainers.version>
    </properties>

    <modules>
        <module>common-domain</module>
        <module>common-adapter</module>
        <module>cortex-domain</module>
        <module>cortex-usecase</module>
        <module>cortex-api</module>
        <module>cortex-llm</module>
        <module>cortex-storage</module>
        <module>cortex-ui</module>
        <module>cortex-db</module>
        <module>application</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>2.0.0-M6</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>be.jsilkens.cortex</groupId>
                <artifactId>common-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>be.jsilkens.cortex</groupId>
                <artifactId>common-adapter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>be.jsilkens.cortex</groupId>
                <artifactId>cortex-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>be.jsilkens.cortex</groupId>
                <artifactId>cortex-domain</artifactId>
                <version>${project.version}</version>
                <classifier>tests</classifier>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>be.jsilkens.cortex</groupId>
                <artifactId>cortex-usecase</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>be.jsilkens.cortex</groupId>
                <artifactId>cortex-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>be.jsilkens.cortex</groupId>
                <artifactId>cortex-llm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>be.jsilkens.cortex</groupId>
                <artifactId>cortex-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>be.jsilkens.cortex</groupId>
                <artifactId>cortex-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>be.jsilkens.cortex</groupId>
                <artifactId>cortex-db</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>be.jsilkens.cortex</groupId>
                <artifactId>application</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.1</version>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>
